{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Customer Churn Prediction - Exploratory Analysis\n",
    "\n",
    "This notebook provides a comprehensive analysis of customer churn patterns and builds a machine learning model to predict churn.\n",
    "\n",
    "**Author:** Navya Ravindran  \n",
    "**Date:** July 2026  \n",
    "**Dataset:** Telecom Customer Churn (Kaggle)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Import Libraries"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from sklearn.preprocessing import StandardScaler, LabelEncoder\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.linear_model import LogisticRegression\n",
    "from sklearn.ensemble import RandomForestClassifier\n",
    "from sklearn.metrics import (\n",
    "    classification_report, confusion_matrix, \n",
    "    roc_auc_score, accuracy_score, precision_score, recall_score, f1_score\n",
    ")\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# Set style for better visualizations\n",
    "sns.set_style('whitegrid')\n",
    "plt.rcParams['figure.figsize'] = (12, 6)\n",
    "\n",
    "print('✅ All libraries imported successfully!')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Load and Explore Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load dataset\n",
    "df = pd.read_csv('churn_data.csv')\n",
    "\n",
    "print(f'Dataset shape: {df.shape[0]} rows, {df.shape[1]} columns')\n",
    "print(f'\\nFirst 5 rows:')\n",
    "df.head()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Data info\n",
    "print('Dataset Info:')\n",
    "df.info()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Check missing values\n",
    "print('Missing Values:')\n",
    "missing = df.isnull().sum()\n",
    "if missing.sum() == 0:\n",
    "    print('✅ No missing values!')\n",
    "else:\n",
    "    print(missing[missing > 0])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Statistical summary\n",
    "print('Statistical Summary:')\n",
    "df.describe()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Exploratory Data Analysis (EDA)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Churn distribution\n",
    "plt.figure(figsize=(10, 5))\n",
    "\n",
    "# Count plot\n",
    "plt.subplot(1, 2, 1)\n",
    "churn_counts = df['Churn'].value_counts()\n",
    "sns.countplot(data=df, x='Churn', palette='Set2')\n",
    "plt.title('Churn Distribution', fontsize=14, fontweight='bold')\n",
    "plt.xlabel('Churn')\n",
    "plt.ylabel('Count')\n",
    "\n",
    "# Pie chart\n",
    "plt.subplot(1, 2, 2)\n",
    "churn_pct = df['Churn'].value_counts(normalize=True) * 100\n",
    "colors = ['#2ecc71', '#e74c3c']\n",
    "plt.pie(churn_pct, labels=['No Churn', 'Churn'], autopct='%1.1f%%', \n",
    "        colors=colors, startangle=90)\n",
    "plt.title('Churn Percentage', fontsize=14, fontweight='bold')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(f'No Churn: {churn_counts[0]} ({churn_counts[0]/len(df)*100:.1f}%)')\n",
    "print(f'Churn: {churn_counts[1]} ({churn_counts[1]/len(df)*100:.1f}%)')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Correlation analysis for numerical columns\n",
    "numerical_cols = df.select_dtypes(include=[np.number]).columns\n",
    "correlation_matrix = df[numerical_cols].corr()\n",
    "\n",
    "plt.figure(figsize=(12, 8))\n",
    "sns.heatmap(correlation_matrix, annot=True, cmap='coolwarm', center=0, \n",
    "            fmt='.2f', square=True, linewidths=1)\n",
    "plt.title('Correlation Matrix', fontsize=14, fontweight='bold')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Churn by key features\n",
    "fig, axes = plt.subplots(2, 2, figsize=(14, 10))\n",
    "\n",
    "# Churn by contract type (if exists)\n",
    "if 'Contract' in df.columns:\n",
    "    sns.countplot(data=df, x='Contract', hue='Churn', ax=axes[0, 0], palette='Set2')\n",
    "    axes[0, 0].set_title('Churn by Contract Type', fontweight='bold')\n",
    "\n",
    "# Churn by internet service (if exists)\n",
    "if 'InternetService' in df.columns:\n",
    "    sns.countplot(data=df, x='InternetService', hue='Churn', ax=axes[0, 1], palette='Set2')\n",
    "    axes[0, 1].set_title('Churn by Internet Service', fontweight='bold')\n",
    "\n",
    "# Churn by tenure\n",
    "if 'tenure' in df.columns:\n",
    "    df.groupby('Churn')['tenure'].hist(ax=axes[1, 0], alpha=0.6)\n",
    "    axes[1, 0].set_title('Tenure Distribution by Churn', fontweight='bold')\n",
    "    axes[1, 0].set_xlabel('Tenure (months)')\n",
    "\n",
    "# Churn by monthly charges\n",
    "if 'MonthlyCharges' in df.columns:\n",
    "    df.boxplot(column='MonthlyCharges', by='Churn', ax=axes[1, 1])\n",
    "    axes[1, 1].set_title('Monthly Charges by Churn', fontweight='bold')\n",
    "    axes[1, 1].set_xlabel('Churn')\n",
    "    axes[1, 1].set_ylabel('Monthly Charges')\n",
    "\n",
    "plt.suptitle('')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Data Preprocessing"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create copy for processing\n",
    "df_processed = df.copy()\n",
    "\n",
    "# Remove missing values\n",
    "df_processed = df_processed.dropna()\n",
    "\n",
    "print(f'✅ Rows after removing missing values: {len(df_processed)}')\n",
    "\n",
    "# Encode target variable\n",
    "le_churn = LabelEncoder()\n",
    "df_processed['Churn'] = le_churn.fit_transform(df_processed['Churn'])\n",
    "\n",
    "print(f'✅ Churn variable encoded: {df_processed[\"Churn\"].unique()}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Encode categorical features\n",
    "print('\\nEncoding categorical features...')\n",
    "\n",
    "X = df_processed.drop('Churn', axis=1)\n",
    "y = df_processed['Churn']\n",
    "\n",
    "# Get categorical columns\n",
    "categorical_cols = X.select_dtypes(include=['object']).columns\n",
    "\n",
    "# Encode each categorical column\n",
    "for col in categorical_cols:\n",
    "    le = LabelEncoder()\n",
    "    X[col] = le.fit_transform(X[col])\n",
    "    print(f'  ✅ {col} encoded')\n",
    "\n",
    "print(f'\\n✅ All categorical features encoded')\n",
    "print(f'Features shape: {X.shape}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Scale numerical features\n",
    "print('Scaling features...')\n",
    "\n",
    "scaler = StandardScaler()\n",
    "X_scaled = scaler.fit_transform(X)\n",
    "\n",
    "print(f'✅ Features scaled using StandardScaler')\n",
    "print(f'Scaled data shape: {X_scaled.shape}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Train-test split\n",
    "print('Splitting data into train and test sets...')\n",
    "\n",
    "X_train, X_test, y_train, y_test = train_test_split(\n",
    "    X_scaled, y, test_size=0.2, random_state=42, stratify=y\n",
    ")\n",
    "\n",
    "print(f'✅ Train set size: {X_train.shape[0]} ({X_train.shape[0]/len(X_scaled)*100:.1f}%)')\n",
    "print(f'✅ Test set size: {X_test.shape[0]} ({X_test.shape[0]/len(X_scaled)*100:.1f}%)')\n",
    "print(f'✅ Number of features: {X_train.shape[1]}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Model Training"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Train Logistic Regression\n",
    "print('Training Logistic Regression...')\n",
    "\n",
    "lr_model = LogisticRegression(max_iter=1000, random_state=42)\n",
    "lr_model.fit(X_train, y_train)\n",
    "\n",
    "lr_pred = lr_model.predict(X_test)\n",
    "lr_pred_proba = lr_model.predict_proba(X_test)[:, 1]\n",
    "\n",
    "print('✅ Training complete!')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Train Random Forest\n",
    "print('Training Random Forest...')\n",
    "\n",
    "rf_model = RandomForestClassifier(n_estimators=100, random_state=42, n_jobs=-1)\n",
    "rf_model.fit(X_train, y_train)\n",
    "\n",
    "rf_pred = rf_model.predict(X_test)\n",
    "rf_pred_proba = rf_model.predict_proba(X_test)[:, 1]\n",
    "\n",
    "print('✅ Training complete!')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Model Evaluation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Logistic Regression evaluation\n",
    "print('='*70)\n",
    "print('LOGISTIC REGRESSION RESULTS')\n",
    "print('='*70)\n",
    "\n",
    "lr_accuracy = accuracy_score(y_test, lr_pred)\n",
    "lr_precision = precision_score(y_test, lr_pred)\n",
    "lr_recall = recall_score(y_test, lr_pred)\n",
    "lr_f1 = f1_score(y_test, lr_pred)\n",
    "lr_auc = roc_auc_score(y_test, lr_pred_proba)\n",
    "\n",
    "print(f'\\n📊 Performance Metrics:')\n",
    "print(f'  Accuracy:  {lr_accuracy:.4f}')\n",
    "print(f'  Precision: {lr_precision:.4f}')\n",
    "print(f'  Recall:    {lr_recall:.4f}')\n",
    "print(f'  F1-Score:  {lr_f1:.4f}')\n",
    "print(f'  ROC-AUC:   {lr_auc:.4f}')\n",
    "\n",
    "print(f'\\n📋 Classification Report:')\n",
    "print(classification_report(y_test, lr_pred, target_names=['No Churn', 'Churn']))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Random Forest evaluation\n",
    "print('='*70)\n",
    "print('RANDOM FOREST RESULTS')\n",
    "print('='*70)\n",
    "\n",
    "rf_accuracy = accuracy_score(y_test, rf_pred)\n",
    "rf_precision = precision_score(y_test, rf_pred)\n",
    "rf_recall = recall_score(y_test, rf_pred)\n",
    "rf_f1 = f1_score(y_test, rf_pred)\n",
    "rf_auc = roc_auc_score(y_test, rf_pred_proba)\n",
    "\n",
    "print(f'\\n📊 Performance Metrics:')\n",
    "print(f'  Accuracy:  {rf_accuracy:.4f}')\n",
    "print(f'  Precision: {rf_precision:.4f}')\n",
    "print(f'  Recall:    {rf_recall:.4f}')\n",
    "print(f'  F1-Score:  {rf_f1:.4f}')\n",
    "print(f'  ROC-AUC:   {rf_auc:.4f}')\n",
    "\n",
    "print(f'\\n📋 Classification Report:')\n",
    "print(classification_report(y_test, rf_pred, target_names=['No Churn', 'Churn']))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Model comparison\n",
    "print('\\n' + '='*70)\n",
    "print('MODEL COMPARISON')\n",
    "print('='*70)\n",
    "\n",
    "comparison_df = pd.DataFrame({\n",
    "    'Logistic Regression': {\n",
    "        'Accuracy': lr_accuracy,\n",
    "        'Precision': lr_precision,\n",
    "        'Recall': lr_recall,\n",
    "        'F1-Score': lr_f1,\n",
    "        'ROC-AUC': lr_auc\n",
    "    },\n",
    "    'Random Forest': {\n",
    "        'Accuracy': rf_accuracy,\n",
    "        'Precision': rf_precision,\n",
    "        'Recall': rf_recall,\n",
    "        'F1-Score': rf_f1,\n",
    "        'ROC-AUC': rf_auc\n",
    "    }\n"})"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Visualize model comparison\n",
    "metrics = ['Accuracy', 'Precision', 'Recall', 'F1-Score', 'ROC-AUC']\n",
    "lr_scores = [lr_accuracy, lr_precision, lr_recall, lr_f1, lr_auc]\n",
    "rf_scores = [rf_accuracy, rf_precision, rf_recall, rf_f1, rf_auc]\n",
    "\n",
    "x = np.arange(len(metrics))\n",
    "width = 0.35\n",
    "\n",
    "plt.figure(figsize=(12, 6))\n",
    "plt.bar(x - width/2, lr_scores, width, label='Logistic Regression', alpha=0.8)\n",
    "plt.bar(x + width/2, rf_scores, width, label='Random Forest', alpha=0.8)\n",
    "\n",
    "plt.xlabel('Metrics', fontsize=12, fontweight='bold')\n",
    "plt.ylabel('Score', fontsize=12, fontweight='bold')\n",
    "plt.title('Model Performance Comparison', fontsize=14, fontweight='bold')\n",
    "plt.xticks(x, metrics)\n",
    "plt.legend()\n",
    "plt.ylim([0.6, 1.0])\n",
    "plt.grid(axis='y', alpha=0.3)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print('\\n🏆 Best Model: Random Forest' if rf_auc > lr_auc else '\\n🏆 Best Model: Logistic Regression')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Confusion matrices\n",
    "fig, axes = plt.subplots(1, 2, figsize=(12, 4))\n",
    "\n",
    "# LR confusion matrix\n",
    "cm_lr = confusion_matrix(y_test, lr_pred)\n",
    "sns.heatmap(cm_lr, annot=True, fmt='d', cmap='Blues', ax=axes[0], \n",
    "            xticklabels=['No Churn', 'Churn'],\n",
    "            yticklabels=['No Churn', 'Churn'])\n",
    "axes[0].set_title('Logistic Regression\\nConfusion Matrix', fontweight='bold')\n",
    "axes[0].set_ylabel('True Label')\n",
    "axes[0].set_xlabel('Predicted Label')\n",
    "\n",
    "# RF confusion matrix\n",
    "cm_rf = confusion_matrix(y_test, rf_pred)\n",
    "sns.heatmap(cm_rf, annot=True, fmt='d', cmap='Greens', ax=axes[1],\n",
    "            xticklabels=['No Churn', 'Churn'],\n",
    "            yticklabels=['No Churn', 'Churn'])\n",
    "axes[1].set_title('Random Forest\\nConfusion Matrix', fontweight='bold')\n",
    "axes[1].set_ylabel('True Label')\n",
    "axes[1].set_xlabel('Predicted Label')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Key Findings & Insights"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print('='*70)\n",
    "print('KEY FINDINGS & BUSINESS INSIGHTS')\n",
    "print('='*70)\n",
    "\n",
    "print(f'''\n✅ MODEL PERFORMANCE:\n   - Random Forest ROC-AUC: {rf_auc:.4f}\n   - Logistic Regression ROC-AUC: {lr_auc:.4f}\n   - Best Model: Random Forest\n\n📊 CHURN STATISTICS:\n   - Overall churn rate: {(y.sum()/len(y)*100):.1f}%\n   - Test set churn rate: {(y_test.sum()/len(y_test)*100):.1f}%\n\n🎯 MODEL INSIGHTS:\n   - Precision: {rf_precision:.4f} (Of predicted churners, {rf_precision*100:.1f}% actually churned)\n   - Recall: {rf_recall:.4f} (Model catches {rf_recall*100:.1f}% of actual churners)\n   - Accuracy: {rf_accuracy:.4f} (Model correct {rf_accuracy*100:.1f}% of the time)\n\n💡 BUSINESS IMPACT:\n   - Identify high-risk customers for targeted retention\n   - Reduce customer acquisition costs by retaining existing customers\n   - Focus resources on customers most likely to churn\n   - Improve overall customer lifetime value\n\n📈 NEXT STEPS:\n   - Deploy model in production\n   - Monitor model performance over time\n   - Implement retention strategies for predicted churners\n   - A/B test retention offers and campaigns\n''')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 8. Conclusion"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
